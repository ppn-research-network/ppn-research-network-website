---
import SiteLayout from '../layouts/SiteLayout.astro';
import { withBase } from '../lib/url';
---

<SiteLayout title="Page not found">
  <div class="mx-auto max-w-2xl px-5 py-20">
    <h1 class="text-4xl sm:text-5xl">Page not found</h1>
    <p class="mt-4 text-lg text-[#33403a]">The page you were looking for doesn't exist or has moved.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={withBase('/')} class="btn-primary">Go to the home page</a>
      <a href={withBase('/data/')} class="btn-secondary">Data directory</a>
      <a href={withBase('/skills/')} class="btn-secondary">Skills directory</a>
    </div>
  </div>
</SiteLayout>
