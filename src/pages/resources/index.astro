---
// Members only. No resource is in the page itself: they load from the
// database after an approved member signs in.
import SiteLayout from '../../layouts/SiteLayout.astro';
import ResourcesApp from '../../components/resources/ResourcesApp.tsx';
---

<SiteLayout
  title="Resources"
  current="resources"
  membersFooter
  footerNote="Resources are shared by members for members. Each file remains the work of the person who shared it."
>
  <div class="mx-auto max-w-6xl px-5 py-10 md:py-14">
    <ResourcesApp client:only="react">
      <p slot="fallback" class="min-h-[90vh] text-muted">Checking your membership…</p>
    </ResourcesApp>
  </div>
</SiteLayout>
