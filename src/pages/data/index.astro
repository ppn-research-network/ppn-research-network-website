---
import SiteLayout from '../../layouts/SiteLayout.astro';
import DataDirectory from '../../components/directory/DataDirectory.tsx';
import { withBase } from '../../lib/url';
---

<SiteLayout title="Data directory" current="data">
  <div class="mx-auto max-w-6xl px-5 py-10 md:py-14">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <h1 class="text-4xl sm:text-5xl">Data directory</h1>
        <p class="mt-4 max-w-2xl text-[#33403a] sm:text-lg">
          Descriptions of Australian nutrition datasets that custodians are willing to share. Each listing says how to
          request access; the data stays with the custodian.
        </p>
      </div>
      <a href={withBase('/submit/')} class="btn-secondary hidden sm:inline-flex">Submit a dataset</a>
    </div>
    <div class="mt-8">
      <DataDirectory client:only="react" />
    </div>
  </div>
</SiteLayout>
