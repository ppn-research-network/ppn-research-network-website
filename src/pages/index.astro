---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import RecentDatasets from '../components/RecentDatasets.tsx';
import { INSTITUTION_COUNT, MEMBERSHIP_INVITATION } from '../../site.config.mjs';
import LatestNews from '../components/news/LatestNews.tsx';
import { withBase } from '../lib/url';

const steps = [
  {
    title: 'Describe it',
    text: 'Custodians list a dataset, or researchers add a skills profile. Only descriptions are shared, never the data itself.',
  },
  {
    title: 'We review it',
    text: 'A network admin checks every submission before it appears in the directory.',
  },
  {
    title: 'Connect',
    text: 'Send a message through the site. Email addresses stay private, and replies go directly between you.',
  },
];
---

<SiteLayout>
  <!-- Hero -->
  <section class="mx-auto grid max-w-6xl gap-12 px-5 pt-14 pb-16 md:pt-20 lg:grid-cols-[1.35fr_1fr] lg:items-center">
    <div>
      <p class="eyebrow">Precision &amp; Personalised Nutrition Research Network</p>
      <h1 class="mt-4 text-4xl leading-[1.1] sm:text-5xl lg:text-[3.1rem]">
        Connect with data, expertise and collaborators to advance precision and personalised nutrition.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[#33403a]">
        Discover research datasets, connect across disciplines and share resources to build skills and collaborations
        that bring precision and personalised nutrition into practice and improve population health.
      </p>

      <form
        role="search"
        aria-label="Search the directories"
        class="mt-8 flex max-w-xl flex-wrap items-center gap-2 rounded-xl border border-line bg-card p-2 shadow-sm sm:flex-nowrap"
        data-home-search
      >
        <label class="flex min-w-0 flex-1 basis-full items-center gap-2 pl-2 sm:basis-auto">
          <Icon name="search" class="h-4 w-4 shrink-0 text-muted" />
          <span class="sr-only">Search for</span>
          <input
            type="search"
            name="q"
            placeholder="Try metabolomics, CGM or biostatistics"
            class="min-h-10 w-full min-w-0 bg-transparent text-[0.95rem] outline-none placeholder:text-muted"
          />
        </label>
        <label class="flex-1 sm:flex-none">
          <span class="sr-only">Search in</span>
          <select name="in" class="min-h-10 w-full rounded-md border border-line bg-paper px-2 text-sm">
            <option value="data">Datasets</option>
            <option value="skills">People</option>
          </select>
        </label>
        <button type="submit" class="btn-primary">Search</button>
      </form>

      <p class="mt-5 flex items-start gap-2 text-sm text-muted">
        <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-green" />
        Researchers from {INSTITUTION_COUNT} Australian institutions have joined the network.
      </p>
    </div>

    <!-- Illustrative example cards (not real listings) -->
    <div class="relative hidden h-80 lg:block" aria-hidden="true">
      <div class="card absolute top-0 left-0 w-72 rotate-[-2deg] p-5 shadow-sm">
        <div class="flex items-center justify-between">
          <span class="badge bg-open text-open-ink">Open access</span>
          <span class="text-[0.65rem] font-semibold tracking-wider text-muted uppercase">Example</span>
        </div>
        <p class="mt-3 font-serif text-lg leading-snug">Adolescent dietary patterns survey</p>
        <p class="mt-2 text-xs text-muted">Institution C · QLD · Cross-sectional</p>
        <div class="mt-3 flex flex-wrap gap-1.5">
          <span class="tag">Dietary intake</span>
          <span class="tag">Questionnaires</span>
        </div>
      </div>
      <div class="card absolute top-48 right-0 w-64 rotate-[1.5deg] p-5 shadow-sm">
        <div class="flex items-start gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-controlled text-sm font-semibold text-controlled-ink">SW</span>
          <div>
            <p class="font-semibold">Sam Whitfield</p>
            <p class="text-xs text-muted">Biomedical engineer · wearable sensors</p>
            <p class="mt-1 text-xs font-semibold text-green">Open to collaboration</p>
          </div>
        </div>
        <p class="mt-2 text-right text-[0.65rem] font-semibold tracking-wider text-muted uppercase">Example</p>
      </div>
    </div>
  </section>

  <!-- The two directories -->
  <section aria-label="The directories" class="mx-auto grid max-w-6xl gap-5 px-5 pb-20 md:grid-cols-2">
    <div class="card flex flex-col p-7 sm:p-8">
      <Icon name="database" class="h-8 w-8 text-green" />
      <h2 class="mt-4 text-3xl">Data directory</h2>
      <p class="mt-3 leading-relaxed text-[#33403a]">
        Browse descriptions of datasets from Australian studies: dietary intake, metabolomics, gut microbiome, wearables
        and more. See who holds each one and what it takes to use it.
      </p>
      <div class="mt-auto flex flex-wrap gap-3 pt-6">
        <a href={withBase('/data/')} class="btn-primary">Browse datasets</a>
        <a href={withBase('/submit/')} class="btn-secondary">Submit a dataset</a>
      </div>
    </div>
    <div class="card flex flex-col p-7 sm:p-8">
      <Icon name="people" class="h-8 w-8 text-green" />
      <h2 class="mt-4 text-3xl">Skills directory</h2>
      <p class="mt-3 leading-relaxed text-[#33403a]">
        Find collaborators across disciplines, from dietitians and biomedical scientists to engineers, statisticians and
        bioinformaticians. Search by method, skill or what people are looking for.
      </p>
      <div class="mt-auto flex flex-wrap gap-3 pt-6">
        <a href={withBase('/skills/')} class="btn-primary">Browse people</a>
        <a href={withBase('/submit/profile/')} class="btn-secondary">Join the directory</a>
      </div>
    </div>
  </section>

  <!-- Membership -->
  <section aria-labelledby="member-heading" class="mx-auto max-w-6xl px-5 pb-20">
    <div class="flex flex-col gap-6 rounded-2xl border border-line bg-band px-7 py-8 sm:px-10 md:flex-row md:items-center md:justify-between">
      <div class="max-w-3xl">
        <p class="eyebrow flex items-center gap-1.5"><Icon name="lock" class="h-3.5 w-3.5" /> Members</p>
        <h2 id="member-heading" class="mt-2 text-3xl">Become a member</h2>
        <p class="mt-3 leading-relaxed text-[#33403a]">{MEMBERSHIP_INVITATION}</p>
      </div>
      <a href={withBase('/resources/')} class="btn-primary shrink-0">Request membership</a>
    </div>
  </section>

  <!-- How it works -->
  <section aria-labelledby="how-heading" class="bg-band">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 id="how-heading" class="text-3xl">How it works</h2>
      <ol class="mt-8 grid gap-8 md:grid-cols-3">
        {steps.map((step, i) => (
          <li class="border-t-2 border-green pt-5">
            <span class="font-serif text-lg text-accent">0{i + 1}</span>
            <h3 class="mt-2 font-sans text-base font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#4a5550]">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <LatestNews client:idle />

  <RecentDatasets client:idle />

  <!-- Closing call to action -->
  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid gap-6 rounded-2xl bg-green px-7 py-10 text-white sm:px-12 md:grid-cols-[1.5fr_1fr] md:items-center">
      <div>
        <h2 class="text-3xl text-white">Hold a dataset others could use?</h2>
        <p class="mt-3 max-w-xl leading-relaxed text-white/85">
          List a description in about ten minutes. You decide who can access it and on what terms; the data never leaves
          your hands.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={withBase('/submit/')} class="btn-primary !bg-white !text-green hover:!bg-tag">Submit a dataset</a>
        <a href={withBase('/submit/profile/')} class="btn-primary border !border-white/60 !bg-transparent hover:!bg-white/10">
          Join the skills directory
        </a>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  import { withBase } from '../lib/url';

  // Send the search to the chosen directory, e.g. /data/?q=metabolomics
  const form = document.querySelector<HTMLFormElement>('[data-home-search]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const q = String(data.get('q') ?? '').trim();
    const target = data.get('in') === 'skills' ? '/skills/' : '/data/';
    window.location.href = withBase(target) + (q ? `?q=${encodeURIComponent(q)}` : '');
  });
</script>
