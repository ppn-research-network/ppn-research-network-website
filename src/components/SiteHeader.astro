---
import Icon from './Icon.astro';
import { NETWORK_NAME } from '../../site.config.mjs';
import { withBase } from '../lib/url';

import type { NavKey } from '../lib/nav';

interface Props {
  current?: NavKey;
}
const { current } = Astro.props;

const links: { key: NavKey; href: string; label: string; locked?: boolean }[] = [
  { key: 'data', href: '/data/', label: 'Data directory' },
  { key: 'skills', href: '/skills/', label: 'Skills directory' },
  { key: 'resources', href: '/resources/', label: 'Resources', locked: true },
  { key: 'about', href: '/about/', label: 'About' },
  { key: 'sign-in', href: '/sign-in/', label: 'Sign in' },
];
---

<header class="border-b border-line bg-paper">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
    <a href={withBase('/')} class="flex items-center gap-3 rounded-sm py-1 no-underline">
      <img src={withBase('/favicon.svg')} alt="" width="32" height="32" class="h-8 w-8 shrink-0" />
      <span class="max-w-[15rem] font-serif text-[1.05rem] leading-tight font-medium text-ink sm:max-w-none sm:text-lg lg:text-[1.05rem] xl:text-lg">
        {NETWORK_NAME}
      </span>
    </a>

    <nav aria-label="Main" class="hidden items-center gap-5 lg:flex">
      <ul class="flex items-center gap-5 text-sm">
        {links.map((link) => (
          <li>
            <a
              href={withBase(link.href)}
              aria-current={current === link.key ? 'page' : undefined}
              data-account-link={link.key === 'sign-in' ? '' : undefined}
              class:list={[
                'inline-flex items-center gap-1.5 border-b-2 py-2 whitespace-nowrap no-underline',
                current === link.key
                  ? 'border-green font-medium text-green'
                  : 'border-transparent text-ink hover:text-green',
              ]}
            >
              {link.locked && <Icon name="lock" class="h-3.5 w-3.5 text-accent" />}
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={withBase('/submit/')} class="btn-primary whitespace-nowrap">Add a listing</a>
    </nav>

    <button
      type="button"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-line bg-card text-ink lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <Icon name="menu" class="h-5 w-5" />
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Main" class="border-t border-line lg:hidden" hidden>
    <ul class="mx-auto max-w-6xl px-5 py-3">
      {links.map((link) => (
        <li>
          <a
            href={withBase(link.href)}
            aria-current={current === link.key ? 'page' : undefined}
            data-account-link={link.key === 'sign-in' ? '' : undefined}
            class:list={[
              'flex items-center gap-2 rounded-md px-2 py-3 no-underline',
              current === link.key ? 'bg-tag font-medium text-green' : 'text-ink',
            ]}
          >
            {link.locked && <Icon name="lock" class="h-4 w-4 text-accent" />}
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-2 pb-1">
        <a href={withBase('/submit/')} class="btn-primary w-full">Add a listing</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { supabase } from '../lib/supabase';
  import { withBase } from '../lib/url';

  // Signed in? Show initials and "My account" instead of "Sign in".
  supabase.auth.getSession().then(async ({ data }) => {
    const email = data.session?.user.email;
    if (!email) return;
    const { data: member } = await supabase.from('members').select('full_name').maybeSingle();
    const parts = (member?.full_name ?? '').trim().split(/\s+/).filter(Boolean);
    const initials = parts.length ? (parts[0][0] + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase() : email[0].toUpperCase();
    document.querySelectorAll<HTMLAnchorElement>('[data-account-link]').forEach((a) => {
      a.href = withBase('/account/');
      a.replaceChildren();
      const badge = document.createElement('span');
      badge.className = 'flex h-7 w-7 items-center justify-center rounded-full bg-controlled text-[0.7rem] font-semibold text-controlled-ink';
      badge.setAttribute('aria-hidden', 'true');
      badge.textContent = initials;
      a.append(badge, 'My account');
    });
  });

  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>
