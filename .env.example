# Template only. Copy this file to .env and paste your values there.
# .env is never uploaded to GitHub. This file contains no real values.

# Supabase > Project Settings > API (needed from Phase 2)
# These two are public by design and end up in the website code.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API: service role / secret key (needed from Phase 5)
# SECRET: bypasses all security rules. Never put it in website code.
SUPABASE_SERVICE_ROLE_KEY=
